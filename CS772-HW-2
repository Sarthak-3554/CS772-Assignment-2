.0\\}$ for `EPOCHS` epochs. Show plots of the reconstruction and KL loss curves for all three settings.","metadata":{"id":"part3-header"}},{"id":"beta-train","cell_type":"code","source":"betas     = [0.1, 1.0, 10.0]\nhistories = {}\n\nfor beta in betas:\n    print(f\"\\n--- Training β-VAE with β={beta} ---\")\n    model_b = VAE().to(DEVICE)\n    opt_b   = optim.Adam(model_b.parameters(), lr=LR)\n    histories[beta]          = train(model_b, opt_b, vae_loss, train_loader, beta=beta)\n    histories[beta][\"model\"] = model_b\n\nfig, axes = plt.subplots(1, 2, figsize=(14, 5))\ncolors       = {0.1: 'blue', 1.0: 'green', 10.0: 'red'}\nepochs_range = range(1, EPOCHS + 1)\n\nfor beta, hist in histories.items():\n    axes[0].plot(epochs_range, hist['recon'], color=colors[beta], label=f'β={beta}')\n    axes[1].plot(epochs_range, hist['kl'],    color=colors[beta], label=f'β={beta}')\n\naxes[0].set_title('Reconstruction Loss vs Epoch')\naxes[0].set_xlabel('Epoch'); axes[0].set_ylabel('Recon Loss')\naxes[0].legend()\naxes[1].set_title('KL Loss vs Epoch')\naxes[1].set_xlabel('Epoch'); axes[1].set_ylabel('KL Loss')\naxes[1].legend()\n\nplt.suptitle('β-VAE: Reconstruction and KL Loss for β ∈ {0.1, 1.0, 10.0}')\nplt.tight_layout()\nplt.savefig('beta_vae_loss_curves.png', dpi=150)\nplt.show()\n","metadata":{"id":"beta-train","trusted":true,"execution":{"iopub.status.busy":"2026-05-02T17:14:14.215852Z","iopub.execute_input":"2026-05-02T17:14:14.216132Z","iopub.status.idle":"2026-05-02T17:21:11.235768Z","shell.execute_reply.started":"2026-05-02T17:14:14.21611Z","shell.execute_reply":"2026-05-02T17:21:11.234956Z"}},"outputs":[{"name":"stdout","text":"\n--- Training β-VAE with β=0.1 ---\nEpoch 01/20 | Recon: 37.1406 | KL: 14.2766 | Total: 38.5682\nEpoch 02/20 | Recon: 17.0415 | KL: 24.5215 | Total: 19.4936\nEpoch 03/20 | Recon: 14.3514 | KL: 25.0666 | Total: 16.8581\nEpoch 04/20 | Recon: 13.1780 | KL: 25.2629 | Total: 15.7043\nEpoch 05/20 | Recon: 12.4586 | KL: 25.4038 | Total: 14.9990\